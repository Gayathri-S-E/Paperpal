# PaperPal Environment Configuration

# Google Gemini API Configuration (Recommended)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
# Gemini Model selection: "gemini-1.5-flash" (default, fast & cost-efficient), "gemini-2.0-flash", or "gemini-1.5-pro"
GEMINI_MODEL=gemini-1.5-flash

# Optional: OpenAI API Key as an alternative provider
OPENAI_API_KEY=

# AI Provider choice: "auto" (default: uses Gemini if GEMINI_API_KEY is present, then OpenAI, then precision NLP), "gemini", or "openai"
AI_PROVIDER=auto

# Server configuration
PORT=8000
HOST=127.0.0.1
